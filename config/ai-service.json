{
  "schema_version": "2.0",
  "version": "2.0.0",
  "mode": "orchestrated-foundation",
  "default_policy": "human-controlled",
  "provider_binding": "runtime-adapter-registry",
  "direct_provider_calls_allowed": false,
  "principle": "Features request governed capabilities. The AI Service Layer selects an approved adapter, prompt, cache policy and review requirement.",
  "cache": {"enabled": true, "default_ttl_ms": 300000, "max_memory_entries": 500},
  "observability": {"enabled": true, "local_retention": 250, "event_name": "ai.request.completed"},
  "result_states": ["ready", "completed", "unavailable", "manual_review", "blocked", "failed"],
  "default_capability_policy": {"latency_class":"standard","quality_class":"balanced","human_review":"conditional","cache_ttl_ms":300000,"preferred_adapters":["deterministic-local"]},
  "policies": {
    "intent": {"latency_class":"interactive","quality_class":"balanced","human_review":"none","data_class":"guest-public","cache_ttl_ms":900000,"preferred_adapters":["deterministic-local"]},
    "classification": {"latency_class":"batch","quality_class":"standard","human_review":"conditional","data_class":"content","cache_ttl_ms":3600000,"preferred_adapters":["deterministic-local"]},
    "tagging": {"latency_class":"batch","quality_class":"high","human_review":"required-before-publish","data_class":"content","cache_ttl_ms":3600000,"preferred_adapters":["deterministic-local"]},
    "summarization": {"latency_class":"standard","quality_class":"balanced","human_review":"conditional","data_class":"content","cache_ttl_ms":3600000,"preferred_adapters":["deterministic-local"]},
    "guest-assistant": {"latency_class":"interactive","quality_class":"balanced","human_review":"conditional","data_class":"guest-public","cache_ttl_ms":300000},
    "architecture-review": {"latency_class":"deliberate","quality_class":"high","human_review":"required","data_class":"internal","cache_ttl_ms":0},
    "translation": {"latency_class":"standard","quality_class":"high","human_review":"required-before-publish","data_class":"content","cache_ttl_ms":86400000}
  }
}
