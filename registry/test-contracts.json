{
  "schema_version": "1.0",
  "version": "2.0.0",
  "updated_at": "2026-07-28T11:39:30+02:00",
  "policy": {
    "new_capability_requires_contract": true,
    "changed_capability_requires_targeted_tests": true,
    "full_platform_consistency_suite_required": true,
    "automatic_failure_blocks_release": true,
    "unverifiable_requires_manual_review": true,
    "behaviour_contract_required": true,
    "expected_and_forbidden_scenarios_required": true,
    "impact_suite_required": true
  },
  "global_suites": [
    "behaviour-contracts",
    "release-identity",
    "registry-integrity",
    "route-resolution",
    "configuration-compliance",
    "semantic-consistency",
    "ui-language",
    "package-integrity",
    "regression"
  ],
  "components": [
    {
      "id": "ai-workspace",
      "source": "registry/workspace.json",
      "discover": "modules",
      "required_tests": [
        "route-resolves",
        "operational-destination",
        "compact-title-fits",
        "no-mid-word-break",
        "valid-empty-state"
      ],
      "manual_review": [
        "browser-layout",
        "text-clarity"
      ]
    },
    {
      "id": "recommendation-engine",
      "source": "registry/recommendations.json",
      "discover": "recommendations",
      "required_tests": [
        "explainable",
        "human-decision-actions",
        "no-auto-execution",
        "evidence-present"
      ],
      "manual_review": [
        "recommendation-language-quality"
      ]
    },
    {
      "id": "release-governance",
      "source": "release-governance.json",
      "required_tests": [
        "all-automatic-pass",
        "manual-review-explicit",
        "evidence-present"
      ],
      "manual_review": [
        "browser-rendering"
      ]
    },
    {
      "id": "workspace-state-manager",
      "capabilities": [
        "preserve-return-position"
      ],
      "dependencies": [
        "session-storage",
        "mission-control-start-position"
      ],
      "required_tests": [
        "origin-state-captured",
        "destination-cannot-overwrite-origin",
        "explicit-return-restores-scroll",
        "browser-back-restores-scroll",
        "fresh-direct-open-does-not-restore",
        "transaction-cleared-after-restore",
        "start-position-does-not-compete"
      ],
      "manual_review": [
        "deployed-browser-scroll-position"
      ]
    },
    {
      "id": "behaviour-governance",
      "source": "registry/behaviour-contracts.json",
      "discover": "contracts",
      "required_tests": [
        "contract-complete",
        "dependencies-resolve",
        "expected-scenarios-present",
        "forbidden-scenarios-present",
        "impact-areas-present",
        "evidence-resolves"
      ],
      "manual_review": [
        "browser-only-outcomes"
      ]
    }
  ],
  "behaviour_registry": "registry/behaviour-contracts.json"
}
