{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/experience-context.schema.json",
  "title": "Experience Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contextId",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "privacy",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contextId": {
      "type": "string",
      "pattern": "^ctx_[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "purpose",
        "retention"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "operational",
            "personal",
            "sensitive"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experienceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "journeyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "domainId": {
          "type": [
            "string",
            "null"
          ]
        },
        "solutionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeRoute": {
          "type": [
            "string",
            "null"
          ]
        },
        "consentState": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
