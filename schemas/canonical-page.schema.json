{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/canonical-page.schema.json",
  "title": "Canonical Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "locale",
    "status",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "published",
        "archived"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}