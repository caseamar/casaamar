{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casaamar.es/schemas/platform-capability.schema.json",
  "title": "Platform Capability",
  "type": "object",
  "required": [
    "id",
    "name",
    "mission",
    "outcomes",
    "dependencies",
    "services",
    "contracts",
    "reviews",
    "metrics",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "mission": {
      "type": "string",
      "minLength": 20
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "foundation",
        "active",
        "deprecated"
      ]
    }
  },
  "additionalProperties": true
}
