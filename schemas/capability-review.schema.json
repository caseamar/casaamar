{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casaamar.es/schemas/capability-review.schema.json",
  "title": "Capability Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "execution_id", "decision", "reviewer", "decided_at", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["human", "delegated-human"]},
        "display_name": {"type": "string"},
        "assignment": {"type": "string"}
      }
    },
    "reason": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
