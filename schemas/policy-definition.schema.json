{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casaamar.es/schemas/policy-definition.schema.json",
  "title": "Casa Amar Policy Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "priority",
    "applies_to",
    "when",
    "effect",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "inactive",
        "draft"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "when": {
      "type": "object"
    },
    "effect": {
      "enum": [
        "allow",
        "require",
        "manual_review",
        "deny"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
