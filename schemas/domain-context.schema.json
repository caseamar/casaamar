{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain Context Baseline",
  "type": "object",
  "required": [
    "id",
    "domainPack",
    "name",
    "description",
    "objects",
    "facts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "domainPack": {
      "type": "string",
      "minLength": 2
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "proposed",
              "verified"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "predicate",
          "object",
          "status"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "object": {},
          "status": {
            "enum": [
              "observed",
              "proposed",
              "verified"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
