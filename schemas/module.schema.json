{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Casa Amar module",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "foundation",
        "planned",
        "disabled"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}