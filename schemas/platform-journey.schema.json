{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform Journey Registry",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "value_chain",
    "journeys"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "string"
    },
    "value_chain": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
