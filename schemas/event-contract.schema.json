{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Casa Event Envelope",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "occurred_at",
    "source",
    "payload",
    "context",
    "privacy",
    "trace",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$"
    },
    "schema_version": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "service",
        "version"
      ]
    },
    "subject": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "privacy": {
      "type": "object",
      "required": [
        "classification",
        "retention"
      ]
    },
    "trace": {
      "type": "object",
      "required": [
        "correlation_id",
        "causation_id"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "valid",
        "registered",
        "errors"
      ]
    }
  }
}
