{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Casa Amar Event Contract",
  "type": "object",
  "required": [
    "type",
    "owner",
    "required_payload",
    "audited"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "required_payload": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "audited": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
