{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/canonical-entity-reference.schema.json",
  "title": "Canonical Entity Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ]
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}